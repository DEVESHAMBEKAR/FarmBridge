rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() in ['admin', 'system_admin'];
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // Allow update of own profile but block sensitive fields
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Products ──────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Orders ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ─── Carts ─────────────────────────────────────────────────────────────
    match /carts/{cartId} {
      allow read, write: if isSignedIn();
      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }

    // ─── Dealer Requirements ───────────────────────────────────────────────
    match /dealer_requirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Dealer Offers ─────────────────────────────────────────────────────
    match /dealer_offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Negotiations ──────────────────────────────────────────────────────
    match /negotiations/{negId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Deals ─────────────────────────────────────────────────────────────
    match /deals/{dealId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Transport Requests ────────────────────────────────────────────────
    match /transport_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ─── Transport Bookings ────────────────────────────────────────────────
    match /transport_bookings/{bookingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Logistics Requests (legacy bulk) ─────────────────────────────────
    match /logistics_requests/{reqId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Logistics Providers ──────────────────────────────────────────────
    match /logistics_providers/{providerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Audit Logs ────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ─── Reviews ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Chats ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // ─── Wallets ───────────────────────────────────────────────────────────
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow write: if isSignedIn();
      match /transactions/{txId} {
        allow read: if isOwner(walletId) || isAdmin();
        allow create: if isSignedIn();
      }
    }

    // ─── Platform Settings ─────────────────────────────────────────────────
    match /platform_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Support Tickets ──────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
