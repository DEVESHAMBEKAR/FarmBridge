rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'system_admin');
    }

    function isSystemAdmin() {
      return isSignedIn() && getUserRole() == 'system_admin';
    }

    // ═══════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════

    match /users/{uid} {
      // Any signed-in user can read any user profile (for displaying names/photos)
      allow read: if isSignedIn();
      // Only the owner can create/update their own profile
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // PRODUCTS
    // ═══════════════════════════════════════════════

    match /products/{productId} {
      // Any signed-in user can browse products
      allow read: if isSignedIn();
      // Only farmers can create products, and farmer_id must match their UID
      allow create: if isSignedIn() && request.resource.data.farmer_id == request.auth.uid;
      // Allow farmer to update their own, OR allow buyers to update stock during checkout
      allow update: if isSignedIn();
      allow delete: if (isSignedIn() && resource.data.farmer_id == request.auth.uid) || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // ORDERS
    // ═══════════════════════════════════════════════

    match /orders/{orderId} {
      // Buyer, farmer, delivery partner, or admin can read their own orders
      allow read: if isSignedIn() && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.farmer_id == request.auth.uid ||
        resource.data.delivery_partner_id == request.auth.uid ||
        isAdmin()
      );
      // Only buyers can create orders
      allow create: if isSignedIn() && request.resource.data.buyer_id == request.auth.uid;
      // Involved parties can update (status changes)
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Order items subcollection
      match /items/{itemId} {
        allow read: if isSignedIn();
        // Allow write since orders are created in the same batch
        allow write: if isSignedIn();
      }
    }

    // ═══════════════════════════════════════════════
    // CARTS
    // ═══════════════════════════════════════════════

    match /carts/{uid} {
      allow read, write: if isOwner(uid);

      match /items/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ═══════════════════════════════════════════════
    // CHATS
    // ═══════════════════════════════════════════════

    match /chats/{chatId} {
      // Only participants can access the chat
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.sender_id == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════
    // WALLETS
    // ═══════════════════════════════════════════════

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Balance updates should ideally go through Cloud Functions
      allow update: if isOwner(uid) || isAdmin();

      match /transactions/{txnId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
      }
    }

    // ═══════════════════════════════════════════════
    // REVIEWS
    // ═══════════════════════════════════════════════

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.buyer_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.buyer_id == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.buyer_id == request.auth.uid) || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      // Only server/admin can create notifications
      allow create: if isAdmin();
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // ==========================================
    // SYSTEM ADMIN SECURED COLLECTIONS
    // ==========================================

    match /audit_logs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isSystemAdmin();
      allow update, delete: if false; // Immutable ledger
    }

    match /support_tickets/{ticketId} {
      allow read: if isSystemAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    match /platform_settings/{settingId} {
      allow read: if true; // Public configuration
      allow write: if isSystemAdmin();
    }
  }
}
